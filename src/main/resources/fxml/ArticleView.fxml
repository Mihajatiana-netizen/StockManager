<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.stockmanager.controller.ArticleController"
            stylesheets="@../css/style.css">

    <center>
        <VBox spacing="15" styleClass="content">

            <Label text="Gestion des articles"
                   styleClass="page-title"/>

            <GridPane hgap="15" vgap="10">

                <Label text="Référence :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="referenceField"
                           promptText="Ex : ART001"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Nom :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField"
                           promptText="Nom de l'article"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Description :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextArea fx:id="descriptionField"
                          prefRowCount="2"
                          GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Prix d'achat :" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="purchasePriceField"
                           promptText="0.00"
                           GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Prix de vente :" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="sellingPriceField"
                           promptText="0.00"
                           GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <Label text="Stock minimum :" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <TextField fx:id="minimumStockField"
                           text="5"
                           GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <Label text="Catégorie :" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <ComboBox fx:id="categoryComboBox"
                          promptText="Choisir une catégorie"
                          maxWidth="Infinity"
                          GridPane.rowIndex="6" GridPane.columnIndex="1"/>

            </GridPane>

            <HBox spacing="10">
                <Button text="Ajouter" onAction="#handleAdd"/>
                <Button text="Modifier" onAction="#handleUpdate"/>
                <Button text="Supprimer" onAction="#handleDelete"/>
                <Button text="Vider" onAction="#handleClear"/>
            </HBox>

            <Label text="Liste des articles"
                   styleClass="section-title"/>

            <TableView fx:id="articleTable" VBox.vgrow="ALWAYS">

                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="referenceColumn" text="Référence" prefWidth="100"/>
                    <TableColumn fx:id="nameColumn" text="Nom" prefWidth="150"/>
                    <TableColumn fx:id="purchasePriceColumn" text="Prix achat" prefWidth="100"/>
                    <TableColumn fx:id="sellingPriceColumn" text="Prix vente" prefWidth="100"/>
                    <TableColumn fx:id="quantityColumn" text="Quantité" prefWidth="80"/>
                    <TableColumn fx:id="minimumStockColumn" text="Stock min." prefWidth="80"/>
                    <TableColumn fx:id="categoryColumn" text="Catégorie" prefWidth="120"/>
                </columns>

            </TableView>

        </VBox>
    </center>

</BorderPane>
